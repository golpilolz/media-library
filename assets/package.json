{
  "name": "@golpilolz/medialibrary",
  "description": "Media library for Symfony Forms",
  "version": "1.0.0",
  "main": "dist/controller.js",
  "types": "dist/controller.d.ts",
  "config": {
    "css_source": "src/style.css"
  },
  "symfony": {
    "controllers": {
      "media-library": {
        "main": "dist/controller.js",
        "webpackMode": "eager",
        "fetch": "eager",
        "enabled": true,
        "autoimport": {
          "@golpilolz/media-library/dist/style.min.css": true
        }
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0",
      "dropzone": "^6.0.0-beta.2"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "dropzone": "^6.0.0-beta.2"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@types/underscore": "^1.11.15",
    "csso-cli": "^4.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "build": "esbuild src/controller.ts --bundle --format=esm --minify --target=es2020 --external:@hotwired/stimulus --external:dropzone --outfile=dist/controller.js",
    "build:css": "cat src/*.css src/themes/*.css | csso -o dist/style.min.css"
  }
}
