{% block golpilolz_media_library_single_widget %}
    {%- set controller = 'golpilolz--media-library--media-library' -%}
    {#- The widget's strings (French, like LANG in assets/src/lang.ts): one place to change them. #}
    {%- set labels = {
        choose_one: 'Choisir un fichier',
        choose_many: 'Choisir des fichiers',
        browse: 'Parcourir la médiathèque',
        add: 'Ajouter',
        edit: 'Modifier',
        remove: 'Retirer',
        remove_all: 'Tout retirer',
        file: 'fichier',
        files: 'fichiers',
        title: 'Médiathèque',
        close: 'Fermer',
    } -%}
    {%- set dataController = (attr['data-controller']|default('') ~ ' ' ~ controller)|trim -%}
    {%- set ids = value is iterable ? value : (value is empty ? [] : [value]) -%}
    {%- set selected = form.vars.data is iterable ? form.vars.data : (form.vars.data is empty ? [] : [form.vars.data]) -%}
    <div class="golpilolz-media-library-widget ml-theme-{{ theme|default('default') }}"
         data-controller="{{ dataController }}"
         data-{{ controller }}-folders-url-value="{{ path('golpilolz_media-library_folders') }}"
         data-{{ controller }}-folder-files-url-value="{{ path('golpilolz_media-library_folder_files') }}"
         data-{{ controller }}-upload-url-value="{{ upload_url }}"
         data-{{ controller }}-folder-url-value="{{ folder_url|default('') }}"
         data-{{ controller }}-rename-file-url-value="{{ rename_file_url|default('') }}"
         data-{{ controller }}-rename-folder-url-value="{{ rename_folder_url|default('') }}"
         data-{{ controller }}-move-file-url-value="{{ move_file_url|default('') }}"
         data-{{ controller }}-delete-file-url-value="{{ delete_file_url|default('') }}"
         data-{{ controller }}-file-info-url-value="{{ file_info_url|default('') }}"
         data-{{ controller }}-csrf-token-value="{{ media_csrf_token|default('') }}"
         data-{{ controller }}-multiple-value="{{ multiple ? 'true' : 'false' }}">
        {%- set filled = ids|filter(id => id is not empty)|length > 0 -%}
        <button type="button" class="ml-field-empty"{{ filled ? ' hidden' }}
                data-{{ controller }}-target="empty"
                data-action="{{ controller }}#open">
            <span class="ml-field-empty-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.75"/><path d="m21 16-4.5-4.5L8 20"/></svg>
            </span>
            <span class="ml-field-empty-text">
                <span class="ml-field-empty-title">{{ multiple ? labels.choose_many : labels.choose_one }}</span>
                <span class="ml-field-empty-hint">{{ labels.browse }}</span>
            </span>
        </button>
        <div class="ml-field-filled{{ multiple ? ' ml-field-filled--multiple' }}"{{ filled ? '' : ' hidden' }} data-{{ controller }}-target="filled">
            <div class="ml-field-grid">
                <div class="ml-field-preview" data-{{ controller }}-target="preview">
                    {%- for file in selected -%}
                        {%- set url = file.url|default('') -%}
                        {#- Same rule as extension() in utils.ts: the query string and fragment don't count. #}
                        {%- set ext = url|split('?')|first|split('#')|first|split('/')|last|split('.')|last|lower -%}
                        {%- set kind = ext in ['jpg', 'jpeg', 'png', 'gif', 'webp', 'avif', 'svg', 'bmp'] ? 'picture'
                            : ext == 'pdf' ? 'pdf'
                            : ext in ['doc', 'docx', 'odt', 'rtf'] ? 'doc'
                            : ext in ['xls', 'xlsx', 'ods', 'csv'] ? 'xls'
                            : ext in ['zip', 'rar', '7z', 'gz', 'tar'] ? 'zip'
                            : 'txt' -%}
                        <div class="ml-preview-item" data-file-id="{{ file.id }}" title="{{ file.name|default('') }}">
                            <span class="ml-preview-thumb ml-thumb--{{ kind }}">
                                {%- if kind == 'picture' and url is not empty -%}
                                    <img src="{{ url starts with 'http' or url starts with '/' ? url : app.request.basePath ~ '/' ~ url }}" alt="" loading="lazy">
                                {%- endif -%}
                            </span>
                            <span class="ml-preview-name">{{ file.name|default('') }}</span>
                            {%- if multiple -%}
                                <button type="button" class="ml-preview-remove"
                                        data-action="{{ controller }}#remove"
                                        data-{{ controller }}-id-param="{{ file.id }}"
                                        aria-label="{{ labels.remove }} {{ file.name|default('') }}" title="{{ labels.remove }}">
                                    <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
                                </button>
                            {%- endif -%}
                        </div>
                    {%- endfor -%}
                </div>
                {%- if multiple %}
                <button type="button" class="ml-field-add" data-action="{{ controller }}#open">
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <span>{{ labels.add }}</span>
                </button>
                {%- endif %}
            </div>
            <div class="ml-field-actions">
                {%- if multiple %}
                <span class="ml-field-count" data-{{ controller }}-target="count">{{ ids|length }} {{ ids|length > 1 ? labels.files : labels.file }}</span>
                <button type="button" class="ml-field-btn ml-field-btn--danger" data-action="{{ controller }}#clear">{{ labels.remove_all }}</button>
                {%- else %}
                <button type="button" class="ml-field-btn" data-action="{{ controller }}#open">{{ labels.edit }}</button>
                <button type="button" class="ml-field-btn ml-field-btn--danger" data-action="{{ controller }}#clear">{{ labels.remove }}</button>
                {%- endif %}
            </div>
        </div>

        {#- Native modal dialog (showModal()): top layer, inert page, focus trap, Escape. #}
        <dialog class="golpilolz-media-library ml-panel" aria-label="{{ labels.title }}" data-{{ controller }}-target="popup">
            <button type="button" class="ml-close" aria-label="{{ labels.close }}" title="{{ labels.close }}"
                    data-action="{{ controller }}#close">
                <span class="icon-cross" aria-hidden="true"></span>
            </button>
            <div class="ml-loader" data-{{ controller }}-target="loader" hidden>
                <span class="ml-spinner"></span>
            </div>
            <div class="ml-shell" data-{{ controller }}-target="content"></div>
        </dialog>

        {%- for id in ids %}
            <input type="hidden" {{ block('widget_attributes') }} value="{{ id }}"
                   data-{{ controller }}-target="input"/>
        {%- else %}
            {#- Multiple: an empty value would be an invalid choice, so an empty field submits nothing. #}
            <input type="hidden" {{ block('widget_attributes') }} value=""{{ multiple and not disabled ? ' disabled' }}
                   data-{{ controller }}-target="input"/>
        {%- endfor %}
    </div>
{% endblock golpilolz_media_library_single_widget %}
