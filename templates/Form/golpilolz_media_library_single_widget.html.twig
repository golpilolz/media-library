{% block golpilolz_media_library_single_widget %}
    {%- set controller = 'golpilolz--media-library--media-library' -%}
    {%- set dataController = (attr['data-controller']|default('') ~ ' ' ~ controller)|trim -%}
    {%- set ids = value is iterable ? value : (value is empty ? [] : [value]) -%}
    {%- set selected = form.vars.data is iterable ? form.vars.data : (form.vars.data is empty ? [] : [form.vars.data]) -%}
    <div class="golpilolz-media-library-widget"
         data-controller="{{ dataController }}"
         data-{{ controller }}-folders-url-value="{{ path('golpilolz_media-library_folders') }}"
         data-{{ controller }}-upload-url-value="{{ upload_url }}"
         data-{{ controller }}-multiple-value="{{ multiple ? 'true' : 'false' }}">
        <div class="golpilolz-media-library-preview" data-{{ controller }}-target="preview">
            {%- for file in selected -%}
                <span class="ml-preview-name">{{ file.name|default('') }}</span>
            {%- endfor -%}
        </div>
        <div class="btn-group">
            <button type="button" class="btn btn-primary"
                    data-{{ controller }}-target="empty"
                    data-action="{{ controller }}#open">
                Ajouter des images
            </button>
            <button type="button" class="btn btn-primary" hidden
                    data-{{ controller }}-target="filled"
                    data-action="{{ controller }}#open">
                Modifier
            </button>
            <button type="button" class="btn btn-danger" hidden
                    data-{{ controller }}-target="filled"
                    data-action="{{ controller }}#clear">
                Supprimer
            </button>
        </div>

        <div class="popup" data-{{ controller }}-target="popup">
            <div class="golpilolz-media-library popup-content">
                <button type="button" class="close-popup" aria-label="Fermer"
                        data-action="{{ controller }}#close">
                    <span class="icon-cross"></span>
                </button>
                <div class="loader-container" data-{{ controller }}-target="loader" hidden>
                    <span class="loader"></span>
                </div>
                <div class="media-library-content" data-{{ controller }}-target="content"></div>
            </div>
        </div>

        {%- for id in ids %}
            <input type="hidden" {{ block('widget_attributes') }} value="{{ id }}"
                   data-{{ controller }}-target="input"/>
        {%- else %}
            <input type="hidden" {{ block('widget_attributes') }} value=""
                   data-{{ controller }}-target="input"/>
        {%- endfor %}
    </div>
{% endblock golpilolz_media_library_single_widget %}
