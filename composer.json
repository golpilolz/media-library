{
  "name": "golpilolz/media-library",
  "type": "symfony-bundle",
  "description": "Media library for Symfony Form",
  "keywords": [
    "symfony-ux"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Golpilolz and other contributors",
      "homepage": "https://github.com/golpilolz/media-library/graphs/contributors"
    }
  ],
  "autoload": {
    "psr-4": {
      "Golpilolz\\MediaLibrary\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Golpilolz\\MediaLibrary\\Tests\\": "tests/"
    }
  },
  "require": {
    "doctrine/doctrine-bundle": "^2.18 | ^3.2",
    "doctrine/orm": "^3.6",
    "symfony/asset-mapper": "^7.4 | ^8",
    "symfony/security-bundle": "^7.4 | ^8",
    "symfony/security-csrf": "^7.4 | ^8",
    "symfony/serializer": "^7.4 | ^8",
    "symfony/validator": "^7.4 | ^8",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/twig": "^2.12|^3.0"
  },
  "minimum-stability": "dev"
}
